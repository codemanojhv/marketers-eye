{
  "name": "marketers-eye",
  "version": "0.1.0",
  "description": "An evidence-backed marketing intelligence dashboard for channel signals, content, and competitor research.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "marketers-eye": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "harness",
    "skills",
    "examples",
    "web",
    "README.md",
    "LICENSE",
    "web-dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "dev": "npm run build:web && tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run --root .",
    "eval": "tsx evals/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:web": "vite build"
  },
  "keywords": [
    "marketing",
    "marketing-research",
    "growth",
    "competitor-analysis",
    "ad-library",
    "seo",
    "mcp",
    "mcp-server",
    "agents",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemanojhv/marketers-eye.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "csv-parse": "^7.0.3",
    "dompurify": "^3.5.0",
    "marked": "^18.3.0",
    "node-html-parser": "^9.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
